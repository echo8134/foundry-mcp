{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!CHANGELOG.md"] },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "javascript": { "formatter": { "trailingCommas": "none" } },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" }, "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["module/module.json", "package.json", ".release-please-manifest.json"],
      "json": { "formatter": { "expand": "always" } }
    }
  ]
}
